# ---- DHS DATA: NEVER COMMIT (licensed, non-redistributable) ----
# The data/ and data/processed/ folders are tracked (so everyone has the same
# drop spot), but every data file inside stays ignored.
data/*
!data/.gitkeep
!data/README.md
!data/processed/
data/processed/*
!data/processed/.gitkeep
*.DTA
*.dta
*.SAV
*.sav
*.csv
*.CSV
*.zip
*.ZIP
*.dat
*.DAT

# ---- model artifacts (ship via release / git-lfs, not raw) ----
ml/models/*

# ---- secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- python ----
__pycache__/
*.py[cod]
.venv/
.venv-research/
.venv-notebooks/
venv/
env/
.ipynb_checkpoints/
# Executed notebooks can contain licensed survey rows and must stay private.
ml/notebook-runs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- node / angular ----
node_modules/
frontend/dist/
frontend/.angular/

# ---- os / editor ----
.DS_Store
.idea/
.vscode/
*.log

# ---- AI assistant / local tooling (never commit) or add you tools here ----
.claude/
.claude*
CLAUDE.md
.cursor/
.aider*
.openai*
