# Copy to .env and fill in. NEVER commit .env.

# App DB (read-write): predictions, recommendations, feedback, audit
APP_DB_URL=postgresql+psycopg://app:app@localhost:5432/perinatal_app

# Clean data DB (read-only): cleaned DHS cohorts / feature store
CLEAN_DB_URL=postgresql+psycopg://readonly:readonly@localhost:5433/perinatal_clean

# Which model artifact the backend loads (folder under ml/models/)
MODEL_VERSION=stub

# LLM recommendation service 
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=
