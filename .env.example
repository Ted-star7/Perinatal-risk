# Copy to .env and adjust if needed. NEVER commit .env.

# One database holds everything: clinics, doctors, predictions, the combined
# cohort tables, and the model metrics.
APP_DB_URL=postgresql+psycopg://app:app@localhost:5432/perinatal_app

# Trusted fitted pipelines. Defaults use exports from python -m ml.src.train_antenatal_models.
# Optional absolute paths when running the API directly.
# PERINATAL_MODEL_PATH=/path/to/antenatal/perinatal/selected.joblib
# ANC_MODEL_PATH=/path/to/antenatal/perinatal_anc/selected.joblib
# LBW_MODEL_PATH=/path/to/antenatal/lbw/selected.joblib

# For hosted deployments whose build does not contain ml/models, set HTTPS
# release URLs and the matching sha256 values from each selected.json report.
# PERINATAL_MODEL_URL=https://your-model-storage/perinatal.joblib
# PERINATAL_MODEL_SHA256=
# ANC_MODEL_URL=https://your-model-storage/perinatal_anc.joblib
# ANC_MODEL_SHA256=
# LBW_MODEL_URL=https://your-model-storage/lbw.joblib
# LBW_MODEL_SHA256=

# Generate separate persistent secrets with Python secrets.token_urlsafe(48).
# Production requires a JWT_SECRET of at least 32 characters.
APP_ENV=development
JWT_SECRET=
METRICS_KEY=
# METRICS_KEY is required by notebook/CLI publishers. Keep it private.
