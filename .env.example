# Copy to .env and adjust if needed. NEVER commit .env.
# Only needed if you use the database (the dashboards); modeling works without it.

# App DB (read-write): predictions, feedback, model_metrics
APP_DB_URL=postgresql+psycopg://app:app@localhost:5432/perinatal_app

# Clean data DB (read-only): the combined cohorts
CLEAN_DB_URL=postgresql+psycopg://readonly:readonly@localhost:5433/perinatal_clean
